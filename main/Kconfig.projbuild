menu "Fleet telematics node"

    config ELM_SOFTAP_SSID
        string "SoftAP SSID"
        default "ELM327-C6"

    config ELM_SOFTAP_PASS
        string "SoftAP password"
        default "elm327c6"
        help
            Minimum 8 characters.

    config ELM_CMD_TIMEOUT_MS
        int "ELM command timeout (ms)"
        default 12000
        range 500 30000
        help
            OBD command timeout (ms). Auto protocol search often needs 5-15s.

endmenu
