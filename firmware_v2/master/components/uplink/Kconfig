menu "Telemetry uplink (v2)"

    config UPLINK_URL
        string "POST URL for telemetry events (fleet-wide; from bin only)"
        default ""
        help
            Set the real URL in firmware_v2/master/sdkconfig.defaults only
            (CONFIG_UPLINK_URL). Do not duplicate here. Not stored in NVS.

    config UPLINK_TICK_SEC
        int "Uplink GPS tick interval (seconds)"
        default 30
        range 10 3600

    config UPLINK_VEHICLE_WRAP
        bool "Wrap POST body as {\"Vehicle\":[...envelopes...]}"
        default y
        help
            Trafyn nc-events-api currently requires a top-level Vehicle key.
            Disable for lab mocks that accept a bare JSON array of envelopes.

endmenu
