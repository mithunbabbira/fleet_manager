CONFIG_IDF_TARGET="esp32c6"
# CONFIG_BT_ENABLED is not set
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set

# PCB-frozen LTE UART (do not swap)
CONFIG_LTE_ENABLE=y
CONFIG_LTE_UART_TX_GPIO=16
CONFIG_LTE_UART_RX_GPIO=17
CONFIG_LTE_APN="airtelgprs.com"
# M2: modem GNSS (lat/lng + GPS UTC backup for wall clock)
CONFIG_LTE_GPS_ENABLE=y

CONFIG_OTA_CLOUD_AUTO_CHECK=y
CONFIG_OTA_CLOUD_CHECK_URL="https://api.trafyn.info/workflow-engine/realm/1/user/1/v1/execution/service/runWithNoAuth/get-latest-device-firmware?refreshCache=true"
CONFIG_OTA_CLOUD_AUTO_WAIT_SEC=90
CONFIG_OTA_CLOUD_AUTO_INTERVAL_H=4
# Leave auth empty in git — set via USB: ota_token / ota_user
CONFIG_OTA_CLOUD_AUTH_HEADER=""
CONFIG_OTA_CLOUD_SYSTEM_USER_ID=""
